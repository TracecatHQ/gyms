# Gym 001 overlay merged with ../config/tracecat.env.example by `just init`.
PUBLIC_APP_PORT=18080
PUBLIC_APP_URL=http://127.0.0.1:18080
PUBLIC_API_URL=http://127.0.0.1:18080/api
BASE_DOMAIN=:18080
NEXT_PUBLIC_APP_URL=http://127.0.0.1:18080
NEXT_PUBLIC_API_URL=http://127.0.0.1:18080/api
TRACECAT__PUBLIC_APP_URL=http://127.0.0.1:18080
TRACECAT__PUBLIC_API_URL=http://127.0.0.1:18080/api
TRACECAT__ALLOW_ORIGINS=http://127.0.0.1:18080,http://localhost:18080
TRACECAT__AUTH_SUPERADMIN_EMAIL=superadmin@gym-001.example.com
TRACEcat_TENANT_EMAIL=analyst@gym-001.example.com
TRACEcat_TENANT_PASSWORD=REPLACE_WITH_RANDOM_PASSWORD
TRACEcat_SUPERADMIN_EMAIL=superadmin@gym-001.example.com
TRACEcat_SUPERADMIN_PASSWORD=REPLACE_WITH_RANDOM_PASSWORD
TRACECAT__LOCAL_REPOSITORY_PATH=/tmp/gym-001-local-registry

SPLUNK_WEB_PORT=18000
SPLUNK_ADMIN_USER=admin
SPLUNK_ADMIN_PASSWORD=REPLACE_WITH_RANDOM_PASSWORD
SPLUNK_MCP_USER=tracecat_mcp
SPLUNK_MCP_PASSWORD=REPLACE_WITH_RANDOM_PASSWORD
SPLUNK_ACCEPT_TERMS=yes
SPLUNK_START_ARGS=--accept-license
SPLUNK_GENERAL_TERMS=--accept-sgt-current-at-splunk-com
GYM_RECONCILE_TIMEOUT_SECONDS=2400
GYM_DATA_POLL_SECONDS=10
