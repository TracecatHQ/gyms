# Shared Tracecat runtime and Terraform provider
TRACECAT_VERSION=1.0.0-beta.53-rc.1
TRACECAT_API_URL=http://127.0.0.1:18080/api
TRACECAT_API_KEY=replace-with-an-organization-service-account-api-key
PUBLIC_APP_PORT=18080
PUBLIC_APP_URL=http://127.0.0.1:18080
PUBLIC_API_URL=http://127.0.0.1:18080/api
BASE_DOMAIN=:18080
ADDRESS=0.0.0.0
COMPOSE_PROJECT_NAME=tracecat
COMPOSE_BAKE=true

LOG_LEVEL=INFO
INTERNAL_API_URL=http://api:8000
NEXT_PUBLIC_APP_ENV=production
NEXT_PUBLIC_APP_URL=http://127.0.0.1:18080
NEXT_PUBLIC_API_URL=http://127.0.0.1:18080/api
NEXT_SERVER_API_URL=http://api:8000
NODE_ENV=production

TRACECAT__IMAGE_TAG=1.0.0-beta.53-rc.1
TRACECAT__APP_ENV=production
TRACECAT__API_URL=http://api:8000
TRACECAT__API_ROOT_PATH=/api
TRACECAT__PUBLIC_APP_URL=http://127.0.0.1:18080
TRACECAT__PUBLIC_API_URL=http://127.0.0.1:18080/api
TRACECAT__ALLOW_ORIGINS=http://127.0.0.1:18080,http://localhost:18080
TRACECAT__DB_ENCRYPTION_KEY=replace-with-a-fernet-key
TRACECAT__SERVICE_KEY=replace-with-random-hex
TRACECAT__SIGNING_SECRET=replace-with-random-hex
USER_AUTH_SECRET=replace-with-random-hex
TRACECAT__DB_SSLMODE=disable
TRACECAT__POSTGRES_USER=postgres
TRACECAT__POSTGRES_PASSWORD=replace-with-random-password
TRACECAT__DB_URI=postgresql+psycopg://postgres:replace-with-random-password@postgres_db:5432/postgres
TRACECAT__AUTH_TYPES=basic
TRACECAT__AUTH_ALLOWED_DOMAINS=
TRACECAT__AUTH_MIN_PASSWORD_LENGTH=12
TRACECAT__AUTH_SUPERADMIN_EMAIL=
# beta.53 maps agent-presets to the agent_addons entitlement during first migration.
TRACECAT__FEATURE_FLAGS=agent-presets,agent-channels,agent-fs-persistence,ai-ranking,workflow-concurrency-limits
TRACECAT__EE_MULTI_TENANT=true
ENTERPRISE_EDITION=true
TRACECAT__DISABLE_NSJAIL=true
TRACECAT__EXECUTOR_BACKEND=direct
TRACECAT__EXECUTOR_FOR_EACH_MAX_CONCURRENCY=1
TRACECAT__LITELLM_BASE_URL=http://litellm:4000
TRACECAT__LOCAL_REPOSITORY_ENABLED=false
TRACECAT__LOCAL_REPOSITORY_PATH=/tmp/tracecat-empty-registry
TRACECAT__RESULT_EXTERNALIZATION_ENABLED=true
TRACECAT__COLLECTION_MANIFESTS_ENABLED=true
TRACECAT__RESULT_EXTERNALIZATION_THRESHOLD_BYTES=128000
TRACECAT__WORKFLOW_ARTIFACT_RETENTION_DAYS=30
TRACECAT__AGENT_SANDBOX_TIMEOUT=3600
TRACECAT__AGENT_EXECUTOR_MAX_CONCURRENT_ACTIVITIES=1
TRACECAT__AGENT_MAX_CONCURRENT_ACTIVITIES=1

TEMPORAL__CLUSTER_URL=temporal:7233
TEMPORAL__CLUSTER_QUEUE=tracecat-task-queue
TEMPORAL__CLUSTER_NAMESPACE=default
TEMPORAL__POSTGRES_USER=temporal
TEMPORAL__POSTGRES_PASSWORD=replace-with-random-password
TEMPORAL__UI_VERSION=latest
TEMPORAL__DEFAULT_NAMESPACE_RETENTION=24h
TEMPORAL__API_KEY=
MINIO_ROOT_USER=minio
MINIO_ROOT_PASSWORD=replace-with-random-password
REDIS_HOST=redis
REDIS_PORT=6379
REDIS_URL=redis://redis:6379

OIDC_ISSUER=
OIDC_CLIENT_ID=
OIDC_CLIENT_SECRET=
OIDC_SCOPES="openid profile email"
OAUTH_CLIENT_ID=
OAUTH_CLIENT_SECRET=
SAML_IDP_METADATA_URL=
SENTRY_DSN=
OTEL_EXPORTER_OTLP_ENDPOINT=
OTEL_EXPORTER_OTLP_HEADERS=

# Models are selected at Terraform apply time and are not runtime overrides.
CANDIDATE_MODEL_PROVIDER=openai
CANDIDATE_MODEL_NAME=gpt-5.2
JUDGE_MODEL_PROVIDER=openai
JUDGE_MODEL_NAME=gpt-5.2

# Gym 001 target
SPLUNK_WEB_PORT=18000
SPLUNK_ADMIN_PASSWORD=replace-with-random-password
SPLUNK_MCP_AUTHORIZATION="Bearer replace-with-encrypted-splunk-mcp-token"

# Gym 002 target
BOTSV3_ACCESS_KEY=botsv3
BOTSV3_SECRET_KEY=replace-with-random-password

# Gym 003 target and Judge-only Tracecat secret
N8N_ENCRYPTION_KEY=replace-with-random-secret
BUNKERWEB_DB_PASSWORD=replace-with-random-password
BUNKERWEB_API_TOKEN=replace-with-random-token
GYM_003_WAF_PORT=38081
