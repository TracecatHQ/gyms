# Generated by `just init`. The real .env is mode 0600 and ignored by Git.
LOG_LEVEL=INFO
PUBLIC_APP_PORT=28080
PUBLIC_APP_URL=http://127.0.0.1:28080
PUBLIC_API_URL=http://127.0.0.1:28080/api
INTERNAL_API_URL=http://api:8000
BASE_DOMAIN=:28080
ADDRESS=0.0.0.0

NEXT_PUBLIC_APP_ENV=production
NEXT_PUBLIC_APP_URL=http://127.0.0.1:28080
NEXT_PUBLIC_API_URL=http://127.0.0.1:28080/api
NEXT_SERVER_API_URL=http://api:8000

TRACECAT__PLATFORM_OTEL_ENABLED=false
OTEL_EXPORTER_OTLP_ENDPOINT=
OTEL_EXPORTER_OTLP_HEADERS=
TRACECAT__DB_ENCRYPTION_KEY=REPLACE_WITH_FERNET_KEY
TRACECAT__SERVICE_KEY=REPLACE_WITH_RANDOM_HEX
TRACECAT__SIGNING_SECRET=REPLACE_WITH_RANDOM_HEX
USER_AUTH_SECRET=REPLACE_WITH_RANDOM_HEX
TRACECAT__API_URL=http://api:8000
TRACECAT__API_ROOT_PATH=/api
TRACECAT__PUBLIC_APP_URL=http://127.0.0.1:28080
TRACECAT__PUBLIC_API_URL=http://127.0.0.1:28080/api
TRACECAT__ALLOW_ORIGINS=http://127.0.0.1:28080,http://localhost:28080
TRACECAT__DB_SSLMODE=disable
TRACECAT__POSTGRES_USER=postgres
TRACECAT__POSTGRES_PASSWORD=REPLACE_WITH_RANDOM_PASSWORD
TRACECAT__DB_URI=postgresql+psycopg://postgres:REPLACE_WITH_RANDOM_PASSWORD@postgres_db:5432/postgres

TRACECAT__AUTH_SUPERADMIN_EMAIL=superadmin@gym-002.example.com
TRACECAT__AUTH_TYPES=basic
TRACECAT__AUTH_ALLOWED_DOMAINS=
TRACECAT__AUTH_MIN_PASSWORD_LENGTH=12
TRACEcat_TENANT_EMAIL=analyst@gym-002.example.com
TRACEcat_TENANT_PASSWORD=REPLACE_WITH_RANDOM_PASSWORD
TRACEcat_SUPERADMIN_EMAIL=superadmin@gym-002.example.com
TRACEcat_SUPERADMIN_PASSWORD=REPLACE_WITH_RANDOM_PASSWORD
OIDC_ISSUER=
OIDC_CLIENT_ID=
OIDC_CLIENT_SECRET=
OIDC_SCOPES="openid profile email"
OAUTH_CLIENT_ID=
OAUTH_CLIENT_SECRET=
SAML_IDP_METADATA_URL=

TRACECAT_MCP__FILE_TRANSFER_URL_EXPIRY_SECONDS=300
TRACECAT_MCP__STARTUP_MAX_ATTEMPTS=10
TRACECAT_MCP__STARTUP_RETRY_DELAY_SECONDS=3

TEMPORAL__CLUSTER_URL=temporal:7233
TEMPORAL__CLUSTER_QUEUE=tracecat-task-queue
TEMPORAL__CLUSTER_NAMESPACE=default
TEMPORAL__POSTGRES_USER=temporal
TEMPORAL__POSTGRES_PASSWORD=REPLACE_WITH_RANDOM_PASSWORD
TEMPORAL__UI_VERSION=latest
TEMPORAL__DEFAULT_NAMESPACE_RETENTION=24h
TEMPORAL__API_KEY=
TEMPORAL__THREADPOOL_MAX_WORKERS=100
TEMPORAL__MAX_CONCURRENT_ACTIVITIES=100
TEMPORAL__MAX_CONCURRENT_WORKFLOW_TASKS=100
TRACECAT__AGENT_MAX_CONCURRENT_ACTIVITIES=100
TRACECAT__AGENT_EXECUTOR_MAX_CONCURRENT_ACTIVITIES=1

TRACECAT__EXECUTOR_BACKEND=direct
TRACECAT__DISABLE_NSJAIL=true
TRACECAT__LITELLM_BASE_URL=http://litellm:4000
TRACECAT__EXECUTOR_MAX_CONCURRENT_ACTIVITIES=16
TRACECAT__EXECUTOR_THREADPOOL_MAX_WORKERS=16
TRACECAT__EXECUTOR_FOR_EACH_MAX_CONCURRENCY=4
TRACECAT__WORKFLOW_ARTIFACT_RETENTION_DAYS=30
TRACECAT__RESULT_EXTERNALIZATION_ENABLED=true
TRACECAT__COLLECTION_MANIFESTS_ENABLED=true
TRACECAT__RESULT_EXTERNALIZATION_THRESHOLD_BYTES=128000

MINIO_ROOT_USER=minio
MINIO_ROOT_PASSWORD=REPLACE_WITH_RANDOM_PASSWORD
REDIS_URL=redis://redis:6379
TRACECAT__LOCAL_REPOSITORY_ENABLED=false
TRACECAT__LOCAL_REPOSITORY_PATH=/tmp/gym-002-local-registry
PYTHONPATH=/home/apiuser/.local:/app/local_registry
ENTERPRISE_EDITION=true
TRACECAT__FEATURE_FLAGS=agent-channels,agent-fs-persistence,ai-ranking,workflow-concurrency-limits
TRACECAT__EE_MULTI_TENANT=true
SENTRY_DSN=

BOTSV3_BUCKET=botsv3
BOTSV3_ENDPOINT=minio:9000
BOTSV3_ARCHIVE=/run/gym-data/botsv3.zip
