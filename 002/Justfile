set shell := ["bash", "-eu", "-o", "pipefail", "-c"]

gymctl := "PYTHONDONTWRITEBYTECODE=1 PYTHONPATH=../src:src python3 -m gymctl"

default:
    @just --list

init:
    @{{gymctl}} init

doctor:
    @{{gymctl}} doctor

build *components:
    @{{gymctl}} build {{components}}

migrate:
    @{{gymctl}} migrate

up:
    @{{gymctl}} up

info:
    @{{gymctl}} info

status:
    @{{gymctl}} status

wait:
    @{{gymctl}} wait

reconcile:
    @{{gymctl}} reconcile

# Usage: just eval or just eval ALERT_ID=guardduty:c2-contact
eval ALERT_ID="":
    @alert_id="{{ALERT_ID}}"; if [ -n "$alert_id" ]; then {{gymctl}} eval --alert-id "${alert_id#ALERT_ID=}"; else {{gymctl}} eval; fi

# Usage: just workflow-eval or just workflow-eval ALERT_ID=guardduty:c2-contact
workflow-eval ALERT_ID="":
    @alert_id="{{ALERT_ID}}"; if [ -n "$alert_id" ]; then {{gymctl}} eval --via-workflow --alert-id "${alert_id#ALERT_ID=}"; else {{gymctl}} eval --via-workflow; fi

# Usage: just rescore EVAL_ID=20260907T075632Z-4584b519 [ALERT_ID=guardduty:c2-contact]
rescore EVAL_ID="" ALERT_ID="":
    @eval_id="{{EVAL_ID}}"; alert_id="{{ALERT_ID}}"; \
    if [ -z "$eval_id" ]; then echo "EVAL_ID is required" >&2; exit 1; fi; \
    if [ -n "$alert_id" ]; then {{gymctl}} rescore --eval-id "${eval_id#EVAL_ID=}" --alert-id "${alert_id#ALERT_ID=}"; \
    else {{gymctl}} rescore --eval-id "${eval_id#EVAL_ID=}"; fi

logs service="":
    @{{gymctl}} logs {{service}}

down:
    @{{gymctl}} down

restart:
    @{{gymctl}} down
    @{{gymctl}} up

# Usage: just clean-restart CONFIRM=artifacts-captured
clean-restart CONFIRM="":
    @confirm="{{CONFIRM}}"; {{gymctl}} clean-restart --confirm "${confirm#CONFIRM=}"

# Usage: just reset-evals CONFIRM=artifacts-captured
reset-evals CONFIRM="":
    @confirm="{{CONFIRM}}"; {{gymctl}} reset-evals --confirm "${confirm#CONFIRM=}"

# Usage: just reset CONFIRM=artifacts-captured
reset CONFIRM="":
    @confirm="{{CONFIRM}}"; {{gymctl}} reset --confirm "${confirm#CONFIRM=}"

check:
    @{{gymctl}} check

check-upstreams:
    @{{gymctl}} check-upstreams

update-upstreams:
    @{{gymctl}} update-upstreams

update-dataset *args:
    @{{gymctl}} update-dataset {{args}}
