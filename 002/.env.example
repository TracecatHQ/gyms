# Gym 002 overlay merged with ../config/tracecat.env.example by `just init`.
PUBLIC_APP_PORT=28080
PUBLIC_APP_URL=http://127.0.0.1:28080
PUBLIC_API_URL=http://127.0.0.1:28080/api
BASE_DOMAIN=:28080
NEXT_PUBLIC_APP_URL=http://127.0.0.1:28080
NEXT_PUBLIC_API_URL=http://127.0.0.1:28080/api
TRACECAT__PUBLIC_APP_URL=http://127.0.0.1:28080
TRACECAT__PUBLIC_API_URL=http://127.0.0.1:28080/api
TRACECAT__ALLOW_ORIGINS=http://127.0.0.1:28080,http://localhost:28080
TRACECAT__AUTH_SUPERADMIN_EMAIL=superadmin@gym-002.example.com
TRACEcat_TENANT_EMAIL=analyst@gym-002.example.com
TRACEcat_TENANT_PASSWORD=REPLACE_WITH_RANDOM_PASSWORD
TRACEcat_SUPERADMIN_EMAIL=superadmin@gym-002.example.com
TRACEcat_SUPERADMIN_PASSWORD=REPLACE_WITH_RANDOM_PASSWORD
TRACECAT__LOCAL_REPOSITORY_PATH=/tmp/gym-002-local-registry

BOTSV3_BUCKET=botsv3
BOTSV3_ENDPOINT=minio:9000
BOTSV3_ARCHIVE=/run/gym-data/botsv3.zip
