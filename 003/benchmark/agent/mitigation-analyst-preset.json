{
  "name": "Gym 003 Mitigation Analyst",
  "slug": "gym-003-mitigation-analyst",
  "description": "Reviews case evidence and proposes a restricted route/content-type firewall policy without firewall write access.",
  "prompt_file": "mitigation-analyst-prompt.md",
  "model_selection": "organization_default",
  "output_type": {
    "type": "object",
    "additionalProperties": false,
    "properties": {
      "proposal_revision": {
        "type": "integer",
        "minimum": 1
      },
      "exploit_prerequisites": {
        "type": "array",
        "items": {
          "type": "string"
        }
      },
      "demonstrated_impact": {
        "type": "string"
      },
      "policy": {
        "type": "object",
        "additionalProperties": false,
        "properties": {
          "scenario": {
            "type": "string",
            "enum": [
              "supplier-intake"
            ]
          },
          "revision": {
            "type": "integer",
            "minimum": 1,
            "maximum": 1
          },
          "route": {
            "type": "string",
            "enum": [
              "/form/supplier-intake"
            ]
          },
          "method": {
            "type": "string",
            "enum": [
              "POST"
            ]
          },
          "allowed_content_type": {
            "type": "string",
            "enum": [
              "multipart/form-data"
            ]
          }
        },
        "required": [
          "scenario",
          "revision",
          "route",
          "method",
          "allowed_content_type"
        ]
      },
      "rationale": {
        "type": "string"
      },
      "affected_routes": {
        "type": "array",
        "items": {
          "type": "string"
        }
      },
      "benign_compatibility": {
        "type": "array",
        "items": {
          "type": "string"
        }
      },
      "uncertainties": {
        "type": "array",
        "items": {
          "type": "string"
        }
      },
      "rollback_conditions": {
        "type": "array",
        "items": {
          "type": "string"
        }
      },
      "case_tasks": {
        "type": "array",
        "minItems": 3,
        "maxItems": 3,
        "items": {
          "type": "object",
          "additionalProperties": false,
          "properties": {
            "title": {
              "type": "string",
              "enum": [
                "Create BLOCK rule",
                "Create LOG-only rule",
                "Test exploitability"
              ]
            },
            "workflow_alias": {
              "type": "string",
              "enum": [
                "gym-003-rule-application",
                "gym-003-verification"
              ]
            },
            "mode": {
              "type": "string",
              "enum": [
                "BLOCK",
                "LOG_ONLY",
                "VERIFY_ONLY"
              ]
            }
          },
          "required": [
            "title",
            "workflow_alias",
            "mode"
          ]
        }
      }
    },
    "required": [
      "proposal_revision",
      "exploit_prerequisites",
      "demonstrated_impact",
      "policy",
      "rationale",
      "affected_routes",
      "benign_compatibility",
      "uncertainties",
      "rollback_conditions",
      "case_tasks"
    ]
  },
  "actions": [
    "core.cases.create_comment",
    "core.cases.get_case",
    "core.cases.list_comments",
    "core.cases.list_tasks"
  ],
  "namespaces": [],
  "tool_approvals": {
    "core.cases.create_comment": false,
    "core.cases.get_case": false,
    "core.cases.list_comments": false,
    "core.cases.list_tasks": false
  },
  "mcp_integrations": [],
  "agents": {
    "enabled": false,
    "subagents": []
  },
  "retries": 2,
  "enable_thinking": true,
  "enable_internet_access": false
}
