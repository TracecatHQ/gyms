# Lab runner
TRACECAT_VERSION=1.0.0-rc.1
TRACECAT_API_URL=http://127.0.0.1:18080/api
TRACECAT_API_KEY=replace-with-an-organization-service-account-api-key

# Local Tracecat overrides; all other values come from the pinned release.
COMPOSE_PROJECT_NAME=tracecat
PUBLIC_APP_PORT=18080
PUBLIC_APP_URL=http://127.0.0.1:18080
PUBLIC_API_URL=http://127.0.0.1:18080/api
BASE_DOMAIN=:18080
NEXT_PUBLIC_APP_URL=http://127.0.0.1:18080
NEXT_PUBLIC_API_URL=http://127.0.0.1:18080/api
TRACECAT__PUBLIC_APP_URL=http://127.0.0.1:18080
TRACECAT__PUBLIC_API_URL=http://127.0.0.1:18080/api
TRACECAT__ALLOW_ORIGINS=http://127.0.0.1:18080,http://localhost:18080
TRACECAT__DB_ENCRYPTION_KEY=replace-with-a-fernet-key
TRACECAT__SERVICE_KEY=replace-with-random-hex
TRACECAT__SIGNING_SECRET=replace-with-random-hex
USER_AUTH_SECRET=replace-with-random-hex
TRACECAT__POSTGRES_PASSWORD=replace-with-random-password
TRACECAT__DB_URI=postgresql+psycopg://postgres:replace-with-random-password@postgres_db:5432/postgres
TEMPORAL__POSTGRES_PASSWORD=replace-with-random-password
MINIO_ROOT_PASSWORD=replace-with-random-password
TRACECAT__EE_MULTI_TENANT=true
TRACECAT__LOCAL_REPOSITORY_PATH=/tmp/tracecat-empty-registry

# Models
CANDIDATE_MODEL_PROVIDER=openai
CANDIDATE_MODEL_NAME=gpt-5.2
JUDGE_MODEL_PROVIDER=openai
JUDGE_MODEL_NAME=gpt-5.2

# Lab 001
SPLUNK_WEB_PORT=18000
SPLUNK_ADMIN_PASSWORD=replace-with-random-password
SPLUNK_MCP_AUTHORIZATION="Bearer replace-with-encrypted-splunk-mcp-token"

# Lab 002
BOTSV3_ACCESS_KEY=botsv3
BOTSV3_SECRET_KEY=replace-with-random-password

# Lab 003
N8N_ENCRYPTION_KEY=replace-with-random-secret
BUNKERWEB_DB_PASSWORD=replace-with-random-password
BUNKERWEB_API_TOKEN=replace-with-random-token
LAB_003_WAF_PORT=38081
