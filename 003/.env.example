# Gym 003 overlay. `just init` replaces every REPLACE value with a random secret.
PUBLIC_APP_PORT=38080
PUBLIC_APP_URL=http://127.0.0.1:38080
PUBLIC_API_URL=http://127.0.0.1:38080/api
BASE_DOMAIN=:38080
NEXT_PUBLIC_APP_URL=http://127.0.0.1:38080
NEXT_PUBLIC_API_URL=http://127.0.0.1:38080/api
TRACECAT__PUBLIC_APP_URL=http://127.0.0.1:38080
TRACECAT__PUBLIC_API_URL=http://127.0.0.1:38080/api
TRACECAT__ALLOW_ORIGINS=http://127.0.0.1:38080,http://localhost:38080
TRACECAT__AUTH_SUPERADMIN_EMAIL=superadmin@gym-003.example.com
TRACEcat_TENANT_EMAIL=analyst@gym-003.example.com
TRACEcat_TENANT_PASSWORD=REPLACE_WITH_RANDOM_PASSWORD
TRACEcat_SUPERADMIN_EMAIL=superadmin@gym-003.example.com
TRACEcat_SUPERADMIN_PASSWORD=REPLACE_WITH_RANDOM_PASSWORD
TRACECAT__LOCAL_REPOSITORY_PATH=./local_registry
TRACECAT__LOCAL_REPOSITORY_ENABLED=true
BUNKERWEB_API_TOKEN=REPLACE_WITH_RANDOM_TOKEN
BUNKERWEB_DB_PASSWORD=REPLACE_WITH_RANDOM_PASSWORD
GYM_N8N_STAFF_EMAIL=admin@gym-003.example.com
GYM_N8N_STAFF_PASSWORD=REPLACE_WITH_RANDOM_PASSWORD
N8N_ENCRYPTION_KEY=REPLACE_WITH_RANDOM_SECRET
MINIO_GYM_BUCKET=gym-003-evidence
