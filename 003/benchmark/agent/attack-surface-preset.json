{
  "name": "Gym 003 Attack Surface Verifier",
  "slug": "gym-003-attack-surface",
  "description": "Runs only the managed fixed-target verification workflow and classifies sanitized evidence.",
  "prompt_file": "attack-surface-prompt.md",
  "model_selection": "organization_default",
  "output_type": {
    "type": "object",
    "additionalProperties": false,
    "properties": {
      "verdict": {"type": "string", "enum": ["confirmed_file_read", "confirmed_rce", "blocked_by_waf", "not_reproduced", "inconclusive"]},
      "run_id": {"type": "string"},
      "impact": {"type": "string"},
      "evidence": {"type": "array", "items": {"type": "string"}},
      "benign_compatible": {"type": "boolean"},
      "cleanup_status": {"type": "string"},
      "uncertainties": {"type": "array", "items": {"type": "string"}}
    },
    "required": ["verdict", "run_id", "impact", "evidence", "benign_compatible", "cleanup_status", "uncertainties"]
  },
  "actions": ["core.cases.list_comments", "core.workflow.execute"],
  "namespaces": [],
  "tool_approvals": {
    "core.cases.list_comments": false,
    "core.workflow.execute": false
  },
  "mcp_integrations": [],
  "agents": {"enabled": false, "subagents": []},
  "retries": 2,
  "enable_thinking": true,
  "enable_internet_access": false
}
